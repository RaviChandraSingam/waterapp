    updated_at timestamp without time zone DEFAULT now()
);


ALTER TABLE public.meter_readings OWNER TO postgres;

--
-- Name: monthly_records; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.monthly_records (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    year integer NOT NULL,
    month integer NOT NULL,
    status public.record_status DEFAULT 'draft'::public.record_status,
    period_start_date date NOT NULL,
    period_end_date date NOT NULL,
    mid_period_date date,
    cost_per_litre numeric(10,6),
    total_water_input numeric,
    total_water_usage numeric,
    notes text,
    created_by uuid,
    reviewed_by uuid,
    finalized_by uuid,
    reviewed_at timestamp without time zone,
    finalized_at timestamp without time zone,
    created_at timestamp without time zone DEFAULT now(),
    updated_at timestamp without time zone DEFAULT now(),
    CONSTRAINT monthly_records_month_check CHECK (((month >= 1) AND (month <= 12)))
);


ALTER TABLE public.monthly_records OWNER TO postgres;

--
-- Name: page_visits; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.page_visits (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    user_id uuid,
    page character varying(50) NOT NULL,
    visited_at timestamp without time zone DEFAULT now()
);


ALTER TABLE public.page_visits OWNER TO postgres;

--
-- Name: pending_items; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.pending_items (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    title character varying(200) NOT NULL,
    category character varying(50) DEFAULT 'general'::character varying NOT NULL,
    priority character varying(10) DEFAULT 'medium'::character varying NOT NULL,
    planned_period character varying(50),
    associated_cost numeric(12,2),
    recurring boolean DEFAULT false NOT NULL,
    recurrence_pattern character varying(50),
    status character varying(20) DEFAULT 'open'::character varying NOT NULL,
    progress_pct integer DEFAULT 0 NOT NULL,
    worked_on_by character varying(100),
    description text,
    notes text,
    due_date date,
    completed_at timestamp without time zone,
    created_by uuid,
    updated_by uuid,
    created_at timestamp without time zone DEFAULT now(),
    updated_at timestamp without time zone DEFAULT now(),
    seq_no integer NOT NULL,
    CONSTRAINT pending_items_priority_check CHECK (((priority)::text = ANY ((ARRAY['low'::character varying, 'medium'::character varying, 'high'::character varying, 'critical'::character varying])::text[]))),
    CONSTRAINT pending_items_progress_pct_check CHECK (((progress_pct >= 0) AND (progress_pct <= 100))),
    CONSTRAINT pending_items_status_check CHECK (((status)::text = ANY ((ARRAY['open'::character varying, 'in_progress'::character varying, 'on_hold'::character varying, 'done'::character varying, 'cancelled'::character varying])::text[])))
);


ALTER TABLE public.pending_items OWNER TO postgres;

--
-- Name: pending_items_seq_no_seq; Type: SEQUENCE; Schema: public; Owner: postgres
--

CREATE SEQUENCE public.pending_items_seq_no_seq
    AS integer
    START WITH 1
    INCREMENT BY 1
    NO MINVALUE
    NO MAXVALUE
    CACHE 1;


ALTER SEQUENCE public.pending_items_seq_no_seq OWNER TO postgres;

--
-- Name: pending_items_seq_no_seq; Type: SEQUENCE OWNED BY; Schema: public; Owner: postgres
--

ALTER SEQUENCE public.pending_items_seq_no_seq OWNED BY public.pending_items.seq_no;


