    description character varying(255),
    updated_by uuid,
    updated_at timestamp without time zone DEFAULT now()
);


ALTER TABLE public.billing_config OWNER TO postgres;

--
-- Name: blocks; Type: TABLE; Schema: public; Owner: postgres
