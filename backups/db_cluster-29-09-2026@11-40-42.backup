    flat_id uuid NOT NULL,
    start_reading numeric,
    end_reading numeric,
    consumption_litres numeric,
    slab1_qty numeric DEFAULT 0,
    slab2_qty numeric DEFAULT 0,
    slab3_qty numeric DEFAULT 0,
    slab1_cost numeric(12,2) DEFAULT 0,
    slab2_cost numeric(12,2) DEFAULT 0,
    slab3_cost numeric(12,2) DEFAULT 0,
    total_cost numeric(12,2) DEFAULT 0,
